node_modules/
dist/
studio/.vite*/

# made by `npm run grow` in about twenty seconds; run.json beside it says from what
scenes/*/runs/*/growth.json
scenes/*/light/
scenes/*/runs/*.log
scenes/*/*.log

# films are made by `npm run film`; the still beside each is kept
exports/*/frames/
exports/**/*.mp4

.claude/settings.local.json

*.log

# made by `python scripts/sweep_states.py` in bower-blender, in about two minutes
sketches/*/states.js
# made by `node sketches/design-space/grown.mjs` from two grown runs
sketches/*/grown-*.js
# made by `node sketches/design-space/joints.mjs` from the runs of one planting
sketches/*/reached-joints.js
# made by bower-blender/scripts/joint_detail.py in a windowless Blender
sketches/*/joint-detail.js

# scratch pictures while plates are made
exports/deck/.work/
# the full pictures `node pipeline/again.mjs` measures from; the page reads smaller ones
exports/deck/.again/

# the still the live drawing opens on: made by npm run live
studio/public/
